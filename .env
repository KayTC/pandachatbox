# ===== Cấu hình nhà cung cấp AI (OpenAI-compatible) =====
# Dán link API của đơn vị cung cấp vào đây, ví dụ:
#   https://api.openai.com/v1
#   https://api.deepseek.com/v1
#   https://openrouter.ai/api/v1
#   https://your-provider.com/v1
AI_BASE_URL=https://api.vilao.ai/v1
AI_API_KEY=sk-878d8bc1c66e4ad58e025db9eab936a1ba52453da68710f1d39f493a2bcaec0f
AI_MODEL=deepseek-v4.1-flash-req

# Ghi đè system prompt (bỏ trống để dùng prompts/system.md)
# AI_SYSTEM_PROMPT=Bạn là Panda, trợ lý AI thân thiện.

# (Tùy chọn) Header bổ sung nếu nhà cung cấp yêu cầu, dạng JSON
# AI_EXTRA_HEADERS={"HTTP-Referer":"https://your-site.com","X-Title":"Panda Chat Box"}

# (Tùy chọn) Tham số bổ sung gửi kèm request, dạng JSON (vd: giới hạn độ dài, reasoning)
# AI_EXTRA_BODY={"max_tokens":1024}

# Cổng chạy server
PORT=4000
# Chỉ mở trong máy (mặc định). Đổi thành 0.0.0.0 nếu muốn truy cập trong LAN.
HOST=0.0.0.0
